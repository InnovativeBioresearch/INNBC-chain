# START ALPHA CHANGE 1846 -- configure standalone snapshot builder --
INNBC_SNAPSHOT_BUILDER_CHAIN=/etc/innbc/genesis.json
INNBC_SNAPSHOT_BUILDER_SOURCE_DATA_DIR=/var/lib/innbc/node1
INNBC_SNAPSHOT_BUILDER_OUTPUT_ROOT=/var/lib/innbc/snapshots
INNBC_SNAPSHOT_BUILDER_RETENTION_BLOCKS=43200
INNBC_SNAPSHOT_BUILDER_SEGMENT_BLOCKS=1800
# START ALPHA CHANGE 3066 -- separate full-history and recent snapshot MDBX allowances --
INNBC_SNAPSHOT_BUILDER_MDBX_MAP_SIZE_GB=1024
INNBC_SNAPSHOT_BUILDER_SEGMENTED_MDBX_MAP_SIZE_GB=128
# START ALPHA CHANGE 3481 -- configure destination database page size --
# Applies to newly created blockchain and trie databases.
# Snapshot consumers and existing archive databases must match.
INNBC_SNAPSHOT_BUILDER_MDBX_PAGE_SIZE_BYTES=4096
# FINISH ALPHA CHANGE 3481 -- configure destination database page size --
# FINISH ALPHA CHANGE 3066 -- separate full-history and recent snapshot MDBX allowances --
# START ALPHA CHANGE 2277 -- configure independent blockchain database backup output --
INNBC_DATABASE_BACKUP_OUTPUT_ROOT=/var/lib/innbc/database-backups
# FINISH ALPHA CHANGE 2277 -- configure independent blockchain database backup output --

# START ALPHA CHANGE 2081 -- configure historical archives and recovery checkpoints --
INNBC_HISTORY_ARCHIVE_OUTPUT_ROOT=/var/lib/innbc/history-archive
INNBC_HISTORY_ARCHIVE_SEGMENT_BLOCKS=1800
INNBC_HISTORY_ARCHIVE_MAX_INDEX_RECORDS=2000000
INNBC_RECOVERY_CHECKPOINT_MINIMUM_RETENTION_BLOCKS=43200
# FINISH ALPHA CHANGE 2081 -- configure historical archives and recovery checkpoints --
# FINISH ALPHA CHANGE 1846 -- configure standalone snapshot builder --