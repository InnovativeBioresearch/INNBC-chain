# START ALPHA CHANGE 751 -- add private-local validator node profile example --
# START ALPHA CHANGE 3378 -- document inspection beside the packaged private environment example --
# Reference template; node info reads actual /etc/innbc/nodeN.env files.
# After node create, or after installing keys into prepared folders:
# sudo innbc-chain node info node1
# sudo innbc-chain node info all
# Inspection is read-only and prints public identity and recognized environment values.
# Missing or invalid occupied slots cause failure; inspection does not repair them.
# FINISH ALPHA CHANGE 3378 -- document inspection beside the packaged private environment example --
# START ALPHA CHANGE 760 -- document MDBX storage used by private-local profile --
# Persistent blockchain and trie data are stored with MDBX by the node binary.
# FINISH ALPHA CHANGE 760 -- document MDBX storage used by private-local profile --
INNBC_CHAIN=/etc/innbc/genesis.json
INNBC_DATA_DIR=/var/lib/innbc/node1
INNBC_JSONRPC_ADDR=127.0.0.1:8545
INNBC_GRPC_ADDR=127.0.0.1:9632
INNBC_LIBP2P_ADDR=127.0.0.1:30301
# START ALPHA CHANGE 1211 -- document optional private-local advertised peer addresses --
INNBC_NAT_ADDR=
INNBC_DNS_ADDR=
# FINISH ALPHA CHANGE 1211 -- document optional private-local advertised peer addresses --
# START ALPHA CHANGE 2275 -- document private-local RPC query and admission limits --
# START ALPHA CHANGE 2489 -- document private-node log-range fallback --
# Historical event-log range: maximum toBlock - fromBlock.
# Zero selects 256; positive values override it. Separate from fee history.
INNBC_JSONRPC_BLOCK_RANGE_LIMIT=256
# FINISH ALPHA CHANGE 2489 -- document private-node log-range fallback --
# START ALPHA CHANGE 2464 -- configure full-history RPC fee-history budgets --
# This example is for a full-history node.
# Zero selects the corresponding code default; no setting disables protection.
# Percentile limit: 1-100. Result units: served blocks * max(1, requested percentiles).
INNBC_JSONRPC_FEE_HISTORY_BLOCK_LIMIT=256
INNBC_JSONRPC_FEE_HISTORY_PERCENTILE_LIMIT=10
INNBC_JSONRPC_FEE_HISTORY_RESULT_LIMIT=2560
# To permit 512 blocks with 100 percentiles, set these values to 512, 100, 51200.
# Omit these three entries from recent-node environments to inherit code defaults.
# FINISH ALPHA CHANGE 2464 -- configure full-history RPC fee-history budgets --
INNBC_JSONRPC_REQUEST_RATE=100
INNBC_JSONRPC_REQUEST_BURST=200
INNBC_JSONRPC_CALL_RATE=200
INNBC_JSONRPC_CALL_BURST=400
INNBC_JSONRPC_MAX_CONCURRENT=32
INNBC_JSONRPC_MAX_EXPENSIVE=4
INNBC_JSONRPC_MAX_BODY_BYTES=1048576
INNBC_JSONRPC_MAX_WEBSOCKETS=64
INNBC_JSONRPC_MAX_FILTERS=1024
# FINISH ALPHA CHANGE 2275 -- document private-local RPC query and admission limits --
INNBC_PEER_DIRECTORY_ENABLED=true
INNBC_PEER_DIRECTORY_URL=http://127.0.0.1:8080/api/v1/peers/exchange
# START ALPHA CHANGE 852 -- document private-local history mode env defaults --
INNBC_HISTORY_MODE=full
# START ALPHA CHANGE 1735 -- configure the independent checkpoint snapshot source --
INNBC_SNAPSHOT_SOURCE_DIR=/var/lib/innbc/snapshots/checkpoint
INNBC_SNAPSHOT_BOOTSTRAP_REQUIRED=false
# FINISH ALPHA CHANGE 1735 -- configure the independent checkpoint snapshot source --
# START ALPHA CHANGE 3063 -- configure full-history storage with one TiB per MDBX database --
INNBC_MDBX_MAP_SIZE_GB=1024
# START ALPHA CHANGE 3478 -- document configurable database creation pages --
# Existing blockchain and trie databases must match this value.
INNBC_MDBX_PAGE_SIZE_BYTES=4096
# FINISH ALPHA CHANGE 3478 -- document configurable database creation pages --
# FINISH ALPHA CHANGE 3063 -- configure full-history storage with one TiB per MDBX database --
# FINISH ALPHA CHANGE 852 -- document private-local history mode env defaults --
# FINISH ALPHA CHANGE 751 -- add private-local validator node profile example --
