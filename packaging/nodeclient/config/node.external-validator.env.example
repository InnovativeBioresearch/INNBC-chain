# START ALPHA CHANGE 752 -- add external validator node profile example --
# START ALPHA CHANGE 3379 -- document inspection beside the packaged external environment example --
# Reference template; node info reads actual /etc/innbc/nodeN.env files.
# After node create, or after installing keys into prepared folders:
# sudo innbc-chain node info node1
# sudo innbc-chain node info all
# Inspection is read-only and prints public identity and recognized environment values.
# Missing or invalid occupied slots cause failure; inspection does not repair them.
# FINISH ALPHA CHANGE 3379 -- document inspection beside the packaged external environment example --
# START ALPHA CHANGE 761 -- document MDBX storage used by external-validator profile --
# Persistent blockchain and trie data are stored with MDBX by the node binary.
# FINISH ALPHA CHANGE 761 -- document MDBX storage used by external-validator profile --
INNBC_CHAIN=/etc/innbc/genesis.json
INNBC_DATA_DIR=/var/lib/innbc/node1
INNBC_JSONRPC_ADDR=127.0.0.1:8545
INNBC_GRPC_ADDR=127.0.0.1:9632
INNBC_LIBP2P_ADDR=0.0.0.0:30301
# START ALPHA CHANGE 1212 -- document required external advertised peer address placeholders --
INNBC_NAT_ADDR=
INNBC_DNS_ADDR=
# FINISH ALPHA CHANGE 1212 -- document required external advertised peer address placeholders --
# START ALPHA CHANGE 2275 -- document external-validator RPC query and admission limits --
# START ALPHA CHANGE 2490 -- document external-node log-range fallback --
# Historical event-log range: maximum toBlock - fromBlock.
# Zero selects 256; positive values override it. Separate from fee history.
INNBC_JSONRPC_BLOCK_RANGE_LIMIT=256
# FINISH ALPHA CHANGE 2490 -- document external-node log-range fallback --
# START ALPHA CHANGE 2465 -- configure external full-history RPC fee-history budgets --
# This example is for a full-history node; external connectivity does not change the limits.
# Zero selects the corresponding code default; no setting disables protection.
# Percentile limit: 1-100. Result units: served blocks * max(1, requested percentiles).
INNBC_JSONRPC_FEE_HISTORY_BLOCK_LIMIT=256
INNBC_JSONRPC_FEE_HISTORY_PERCENTILE_LIMIT=10
INNBC_JSONRPC_FEE_HISTORY_RESULT_LIMIT=2560
# To permit 512 blocks with 100 percentiles, set these values to 512, 100, 51200.
# Omit these three entries from recent-node environments to inherit code defaults.
# FINISH ALPHA CHANGE 2465 -- configure external full-history RPC fee-history budgets --
INNBC_JSONRPC_REQUEST_RATE=100
INNBC_JSONRPC_REQUEST_BURST=200
INNBC_JSONRPC_CALL_RATE=200
INNBC_JSONRPC_CALL_BURST=400
INNBC_JSONRPC_MAX_CONCURRENT=32
INNBC_JSONRPC_MAX_EXPENSIVE=4
INNBC_JSONRPC_MAX_BODY_BYTES=1048576
INNBC_JSONRPC_MAX_WEBSOCKETS=64
INNBC_JSONRPC_MAX_FILTERS=1024
# FINISH ALPHA CHANGE 2275 -- document external-validator RPC query and admission limits --
INNBC_PEER_DIRECTORY_ENABLED=true
INNBC_PEER_DIRECTORY_URL=https://innbcchain.io/api/v1/peers/exchange
# START ALPHA CHANGE 853 -- document external-validator history mode env defaults --
INNBC_HISTORY_MODE=full
# START ALPHA CHANGE 1740 -- configure independent checkpoint snapshot consumption --
INNBC_SNAPSHOT_SOURCE_DIR=/var/lib/innbc/snapshots/checkpoint
INNBC_SNAPSHOT_BOOTSTRAP_REQUIRED=false
# FINISH ALPHA CHANGE 1740 -- configure independent checkpoint snapshot consumption --
# START ALPHA CHANGE 3064 -- configure external full-history storage with one TiB per MDBX database --
INNBC_MDBX_MAP_SIZE_GB=1024
# START ALPHA CHANGE 3479 -- document configurable external-node creation pages --
# Existing blockchain and trie databases must match this value.
INNBC_MDBX_PAGE_SIZE_BYTES=4096
# FINISH ALPHA CHANGE 3479 -- document configurable external-node creation pages --
# FINISH ALPHA CHANGE 3064 -- configure external full-history storage with one TiB per MDBX database --
# FINISH ALPHA CHANGE 853 -- document external-validator history mode env defaults --
# FINISH ALPHA CHANGE 752 -- add external validator node profile example --
