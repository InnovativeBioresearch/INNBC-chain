# START ALPHA CHANGE 999 -- add standalone peer directory service env example --
INNBC_PEER_DIRECTORY_LISTEN=127.0.0.1:8080
INNBC_PEER_DIRECTORY_JSONRPC=http://127.0.0.1:8545
# START ALPHA CHANGE 2287 -- place peer-directory admission settings in the env example --
INNBC_PEER_DIRECTORY_REQUEST_RATE=20
INNBC_PEER_DIRECTORY_REQUEST_BURST=64
INNBC_PEER_DIRECTORY_PEER_INTERVAL=5s
INNBC_PEER_DIRECTORY_PEER_BURST=8
INNBC_PEER_DIRECTORY_MAX_CONCURRENT=32
INNBC_PEER_DIRECTORY_MAX_TRACKED_PEERS=4096
# FINISH ALPHA CHANGE 2287 -- place peer-directory admission settings in the env example --
INNBC_VALIDATOR_REGISTRY=0x0000000000000000000000000000000000000107
INNBC_CHAIN=/etc/innbc/genesis.json
# START ALPHA CHANGE 1919 -- persist authenticated peer directory addresses --
INNBC_PEER_DIRECTORY_CACHE_FILE=/var/lib/innbc/peer-directory/peers.json
# FINISH ALPHA CHANGE 1919 -- persist authenticated peer directory addresses --
# FINISH ALPHA CHANGE 999 -- add standalone peer directory service env example --